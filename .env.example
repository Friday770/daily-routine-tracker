# 复制为 .env 后填写（./setup.sh 会自动复制）

# MySQL 连接。Linux 上建议新建一个专用账号，见 README
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=routine
DB_PASSWORD=在这里填写MySQL密码
DB_NAME=daily_routine

# 服务监听地址和端口
#   0.0.0.0   直接用 http://服务器IP:8000 访问
#   127.0.0.1 只允许本机访问（前面用 nginx 反向代理时）
HOST=0.0.0.0
PORT=8000

# 统一使用的时区（页面、打卡判断、数据库统计都按它），例如 Asia/Shanghai
APP_TIMEZONE=Asia/Shanghai

